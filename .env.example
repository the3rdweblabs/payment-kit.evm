# Copy to .env and fill in.

# Deployer key. Required for network (testnet/mainnet) deploys (deploy-* targets). Simulations
# (simulate-*) run from Foundry's default sender and need no key.
PRIVATE_KEY=0xyourprivatekeyhere

# Public fallback RPCs live in the Makefile (`?=` block), so all make targets
# work even if you uncomment nothing here. Uncomment/override any of them with
# your own provider (Alchemy/QuickNode/Ankr) for higher rate limits.

# Ethereum
#ETH_MAINNET_RPC_URL=https://eth.llamarpc.com
#ETH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# BNB Smart Chain
#BNB_MAINNET_RPC_URL=https://bsc-dataseed.binance.org
#BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545

# Arbitrum One / Arbitrum Sepolia
#ARBITRUM_MAINNET_RPC_URL=https://arb1.arbitrum.io/rpc
#ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Base / Base Sepolia
#BASE_MAINNET_RPC_URL=https://mainnet.base.org
#BASE_TESTNET_RPC_URL=https://sepolia.base.org

# OP Mainnet / OP Sepolia
#OP_MAINNET_RPC_URL=https://mainnet.optimism.io
#OP_TESTNET_RPC_URL=https://sepolia.optimism.io

# Monad (primary test target)
#MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
#MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Hyperliquid HyperEVM
#HYPERLIQUID_MAINNET_RPC_URL=https://rpc.hyperliquid.xyz/evm
#HYPERLIQUID_TESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm

# Robinhood Chain (Arbitrum Orbit L2, gas token ETH)
#ROBINHOOD_MAINNET_RPC_URL=https://rpc.chain.robinhood.com
#ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# X Layer (OKX)
#XLAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech
#XLAYER_TESTNET_RPC_URL=https://testnet.rpc.xlayer.tech

# BOT Chain (testnet faucet: faucet.botchain.ai)
#BOTCHAIN_MAINNET_RPC_URL=https://rpc.botchain.ai
#BOTCHAIN_TESTNET_RPC_URL=https://rpc.bohr.life

# Gasless payments (optional)
# Address of an ERC2771Forwarder, deployed once per chain via:
#   make deploy-forwarder-monad-testnet
# Leave unset (or 0x0) to disable gasless payments for that chain's deploy.
#TRUSTED_FORWARDER=0xyourforwarderaddresshere

# Verification
# Etherscan v2 key - one key covers ethereum/bnb/arbitrum/base/optimism
# including their testnets: https://docs.etherscan.io/etherscan-v2
ETHERSCAN_API_KEY=your-etherscan-v2-api-key
# Other explorers use their own APIs (see [etherscan] in foundry.toml):
#MONADSCAN_API_KEY=
#OKLINK_API_KEY=
